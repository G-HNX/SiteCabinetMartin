{% extends 'base.html.twig' %}

{% block title %}Nous contacter — Cabinet Martin{% endblock %}

{% block main %}
{% include 'components/_page_head.html.twig' with {
    eyebrow: 'Contact',
    title: 'Nous contacter',
    lead: 'Une question, une demande de renseignements ? Écrivez-nous, nous vous répondons rapidement.',
    crumbs: [['Contact', null]]
} only %}

<section class="section">
    <div class="container">
        <div class="contact-grid">
            <aside class="contact-info" data-controller="reveal">
                <h2>Nos coordonnées</h2>
                <ul>
                    <li><i class="bi bi-geo-alt" aria-hidden="true"></i><div><strong>Adresse</strong><p>7, rue des Archives<br>53 000 Laval</p></div></li>
                    <li><i class="bi bi-telephone" aria-hidden="true"></i><div><strong>Téléphone</strong><p><a href="tel:+33299999999">02 99 99 99 99</a></p></div></li>
                    <li><i class="bi bi-envelope" aria-hidden="true"></i><div><strong>Email</strong><p><a href="mailto:contact@cabinet-martin.fr">contact@cabinet-martin.fr</a></p></div></li>
                    <li><i class="bi bi-clock" aria-hidden="true"></i><div><strong>Horaires</strong><p>Lundi – Vendredi : 8h00 – 18h00<br>Samedi : 8h00 – 12h00</p></div></li>
                </ul>
            </aside>

            <div class="card-c card-c--pad" data-controller="reveal">
                <h2 style="font-size: 1.7rem;">Envoyez-nous un message</h2>
                <p class="text-muted-c mb-4">Tous les champs sont obligatoires. Pour une urgence, appelez le 15.</p>

                {{ form_start(contactForm, { attr: { novalidate: 'novalidate', 'data-controller': 'submit-lock', 'data-action': 'submit->submit-lock#lock', 'data-submit-lock-label-value': 'Envoi en cours…' } }) }}
                    {% if contactForm.vars.errors|length %}
                        <div class="form-error-box" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><div>{{ form_errors(contactForm) }}</div></div>
                    {% endif %}

                    <div class="row g-3">
                        <div class="col-md-6">
                            {{ form_row(contactForm.nomContact, { label: 'Votre nom', attr: { placeholder: 'Jean Dupont', autocomplete: 'name' } }) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(contactForm.emailContact, { label: 'Votre adresse email', attr: { placeholder: 'vous@exemple.fr', autocomplete: 'email' } }) }}
                        </div>
                        <div class="col-12">
                            {{ form_row(contactForm.motifContact, { label: 'Votre message', attr: { rows: 6, placeholder: 'Décrivez votre demande…' } }) }}
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg mt-4" data-submit-lock-target="button"><i class="bi bi-send" aria-hidden="true"></i> Envoyer le message</button>
                {{ form_end(contactForm) }}
            </div>
        </div>
    </div>
</section>
{% endblock %}
