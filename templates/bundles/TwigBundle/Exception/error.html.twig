{% extends 'base.html.twig' %}

{% block title %}Erreur {{ status_code }} — Cabinet Martin{% endblock %}

{% block main %}
<section class="error-page">
    <div>
        <div class="error-page__code" aria-hidden="true">{{ status_code }}</div>
        <h1>{% block error_title %}Un imprévu est survenu{% endblock %}</h1>
        <p>{% block error_text %}Une erreur s'est produite de notre côté. Revenez à l'accueil ou contactez-nous si le problème persiste.{% endblock %}</p>
        <div class="error-page__btns">
            <a href="{{ path('app_home') }}" class="btn btn-primary btn-lg"><i class="bi bi-house" aria-hidden="true"></i> Retour à l'accueil</a>
            <a href="{{ path('app_contact') }}" class="btn btn-ghost btn-lg"><i class="bi bi-envelope" aria-hidden="true"></i> Nous contacter</a>
        </div>
    </div>
</section>
{% endblock %}
