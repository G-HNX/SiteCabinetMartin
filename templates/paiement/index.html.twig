{% extends 'base.html.twig' %}

{% block title %}Paiement — Cabinet Martin{% endblock %}

{% block main %}
{% include 'components/_page_head.html.twig' with {
    eyebrow: 'Finaliser',
    title: 'Paiement',
    crumbs: [['Panier', path('app_panier')], ['Paiement', null]]
} only %}

<section class="section">
    <div class="container">
        <ol class="steps" aria-label="Étapes de la commande">
            <li class="is-done"><b><i class="bi bi-check-lg" aria-hidden="true"></i></b> Panier</li>
            <li class="is-current" aria-current="step"><b>2</b> Paiement</li>
            <li><b>3</b> Confirmation</li>
        </ol>

        <div class="cart-layout">
            <div>
                <div class="sim-banner" role="note">
                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                    <p><strong>Paiement simulé — aucune donnée bancaire n'est collectée.</strong><br>
                    Les champs ci-dessous sont factices et ne sont jamais envoyés au serveur. Cliquez simplement sur « Payer ».</p>
                </div>

                <div class="card-c card-c--pad">
                    <div class="fake-card" aria-hidden="true">
                        <div class="fake-card__chip"></div>
                        <div class="fake-card__num">4242 4242 4242 4242</div>
                        <div class="fake-card__row"><span>CABINET MARTIN DEMO</span><span>12/30</span></div>
                    </div>

                    <form method="post" action="{{ path('app_paiement_payer') }}" data-controller="submit-lock" data-action="submit->submit-lock#lock" data-submit-lock-label-value="Paiement en cours…">
                        <input type="hidden" name="_token" value="{{ csrf_token('paiement') }}">

                        {# Champs factices : volontairement sans attribut name #}
                        <div class="row g-3">
                            <div class="col-12">
                                <label for="card-holder" class="form-label">Titulaire de la carte</label>
                                <input type="text" id="card-holder" class="form-control" value="Patient Démo" disabled>
                            </div>
                            <div class="col-12">
                                <label for="card-number" class="form-label">Numéro de carte</label>
                                <div class="input-icon">
                                    <i class="bi bi-credit-card" aria-hidden="true"></i>
                                    <input type="text" id="card-number" class="form-control" value="4242 4242 4242 4242" disabled>
                                </div>
                            </div>
                            <div class="col-6">
                                <label for="card-exp" class="form-label">Expiration</label>
                                <input type="text" id="card-exp" class="form-control" value="12/30" disabled>
                            </div>
                            <div class="col-6">
                                <label for="card-cvc" class="form-label">Cryptogramme</label>
                                <input type="text" id="card-cvc" class="form-control" value="123" disabled>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-accent btn-lg btn-block mt-4" data-submit-lock-target="button">
                            <i class="bi bi-lock" aria-hidden="true"></i> Payer {{ total|format_currency('EUR') }}
                        </button>
                        <p class="field-hint text-center mt-3 mb-0"><a href="{{ path('app_panier') }}">Retour au panier</a></p>
                    </form>
                </div>
            </div>

            <aside class="card-c summary" aria-label="Votre commande">
                <h2>Votre commande</h2>
                <ul class="summary__list">
                    {% for item in items %}
                        <li><span>{{ item.quantite }} × {{ item.nom }}</span><strong>{{ item.sousTotal|format_currency('EUR') }}</strong></li>
                    {% endfor %}
                </ul>
                <div class="summary__total"><span>Total TTC</span><span class="price">{{ total|format_currency('EUR') }}</span></div>
                <ul class="reassure">
                    <li><i class="bi bi-envelope-check" aria-hidden="true"></i>Email de confirmation (Mailpit en démo)</li>
                    <li><i class="bi bi-receipt" aria-hidden="true"></i>Facture PDF dans votre espace</li>
                </ul>
            </aside>
        </div>
    </div>
</section>
{% endblock %}
