{% extends 'base.html.twig' %}

{% block title %}Pharmacie en ligne — Cabinet Martin{% endblock %}

{% block main %}
{% include 'components/_page_head.html.twig' with {
    eyebrow: 'Pharmacie',
    title: 'Pharmacie en ligne',
    lead: 'Parcourez nos catégories de produits de santé et commandez en quelques clics.',
    crumbs: [['Pharmacie', null]]
} only %}

<section class="section">
    <div class="container">
        <div class="cat-grid">
            {% for c in categories %}
                {% set n = c.medicaments|length %}
                <a href="{{ path('app_pharmacie_cat', {cat: c.id}) }}" class="cat-card" data-controller="reveal">
                    <span class="cat-card__icon"><i class="bi bi-capsule-pill" aria-hidden="true"></i></span>
                    <h2>{{ c.nom }}</h2>
                    {% if c.description %}<p>{{ c.description }}</p>{% endif %}
                    <span class="cat-card__count">
                        <span>{{ n }} produit{{ n > 1 ? 's' }}</span>
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </span>
                </a>
            {% else %}
                <div class="empty-inline" style="grid-column: 1 / -1;">
                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                    <p>Aucune catégorie disponible pour le moment.</p>
                </div>
            {% endfor %}
        </div>

        <p class="notice-ordo" style="max-width: 46rem;">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <span>Les médicaments ne sont pas des produits comme les autres. Lisez attentivement la notice et demandez conseil à votre médecin ou à votre pharmacien.</span>
        </p>
    </div>
</section>
{% endblock %}
