{% extends 'base.html.twig' %}

{% block title %}{{ categorie.nom }} — Pharmacie — Cabinet Martin{% endblock %}

{% block main %}
{% include 'components/_page_head.html.twig' with {
    eyebrow: 'Pharmacie',
    title: categorie.nom,
    lead: categorie.description,
    crumbs: [['Pharmacie', path('app_pharmacie')], [categorie.nom, null]]
} only %}

<section class="section">
    <div class="container">
        <nav aria-label="Catégories">
            <ul class="pills">
                {% for c in categories %}
                    <li><a href="{{ path('app_pharmacie_cat', {cat: c.id}) }}" class="{{ c.id == cat ? 'is-active' }}"{% if c.id == cat %} aria-current="page"{% endif %}>{{ c.nom }}</a></li>
                {% endfor %}
            </ul>
        </nav>

        {% if products|length %}
            <p class="text-muted-c" aria-live="polite">{{ products|length }} produit{{ products|length > 1 ? 's' }} dans cette catégorie</p>
            <div class="products">
                {% for p in products %}
                    {% include 'components/_product_card.html.twig' with {p: p, cat: cat} only %}
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state">
                <div class="empty-state__icon"><i class="bi bi-box-seam" aria-hidden="true"></i></div>
                <h2>Rien ici pour l'instant</h2>
                <p>Cette catégorie ne contient aucun produit disponible.</p>
                <a href="{{ path('app_pharmacie') }}" class="btn btn-primary">Retour à la pharmacie</a>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
