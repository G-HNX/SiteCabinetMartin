{% extends 'email/_layout.html.twig' %}

{% block email_title %}Confirmez votre adresse email — Cabinet Martin{% endblock %}
{% block email_icon %}&#9993;{% endblock %}
{% block email_heading %}Confirmez votre adresse email{% endblock %}

{% block email_body %}
<p style="margin:0 0 14px 0;">Bonjour,</p>
<p style="margin:0 0 26px 0;">
    Merci de vous être inscrit sur le portail du <strong>Cabinet Martin</strong>.
    Pour finaliser la création de votre compte, confirmez votre adresse email en cliquant sur le bouton ci-dessous.
</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto 26px auto;">
    <tr>
        <td align="center" style="background-color:#c2543a;border-radius:999px;">
            <a href="{{ signedUrl|raw }}" style="display:inline-block;padding:14px 34px;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;">Confirmer mon adresse email</a>
        </td>
    </tr>
</table>

<p style="margin:0 0 10px 0;font-size:13px;color:#4b6168;">
    Ce lien est valable pendant <strong>{{ expiresAtMessageKey|trans(expiresAtMessageData, 'VerifyEmailBundle') }}</strong>.
</p>
<p style="margin:0 0 10px 0;font-size:12px;color:#6b7f85;word-break:break-all;">
    Le bouton ne fonctionne pas ? Copiez ce lien dans votre navigateur :<br>
    <a href="{{ signedUrl|raw }}" style="color:#0e4f5c;">{{ signedUrl|raw }}</a>
</p>
<p style="margin:0;font-size:12px;color:#6b7f85;">Si vous n'êtes pas à l'origine de cette inscription, ignorez simplement ce message.</p>
{% endblock %}
