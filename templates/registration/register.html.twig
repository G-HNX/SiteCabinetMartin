{% extends 'base.html.twig' %}

{% block title %}Créer un compte — Cabinet Martin{% endblock %}

{% block main %}
<div class="auth">
    <aside class="auth__aside">
        <div>
            <p class="eyebrow" style="color: var(--clay-bright);">Nouveau patient</p>
            <h2>Rejoignez le <em>Cabinet Martin.</em></h2>
            <p>Un compte gratuit pour réserver vos rendez-vous et commander vos produits de santé en ligne.</p>
        </div>
        <ul>
            <li><i class="bi bi-lightning-charge" aria-hidden="true"></i><p><strong>Rapide</strong>Créez votre compte en moins d'une minute.</p></li>
            <li><i class="bi bi-envelope-check" aria-hidden="true"></i><p><strong>Vérifié</strong>Un email de confirmation sécurise votre adresse.</p></li>
            <li><i class="bi bi-shield-lock" aria-hidden="true"></i><p><strong>Confidentiel</strong>Vos données ne sont jamais revendues.</p></li>
        </ul>
    </aside>

    <section class="auth__main">
        <div class="auth__box">
            <h1>Créer un compte</h1>
            <p class="lead-sub">Quelques informations suffisent.</p>

            {{ form_start(registrationForm, { attr: { novalidate: 'novalidate', 'data-controller': 'submit-lock', 'data-action': 'submit->submit-lock#lock', 'data-submit-lock-label-value': 'Création…' } }) }}
                {% if registrationForm.vars.errors|length %}
                    <div class="form-error-box" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><div>{{ form_errors(registrationForm) }}</div></div>
                {% endif %}

                <div class="row g-3">
                    <div class="col-sm-6">{{ form_row(registrationForm.prenom, { label: 'Prénom', attr: { autocomplete: 'given-name', placeholder: 'Jean' } }) }}</div>
                    <div class="col-sm-6">{{ form_row(registrationForm.nom, { label: 'Nom', attr: { autocomplete: 'family-name', placeholder: 'Dupont' } }) }}</div>
                    <div class="col-12">{{ form_row(registrationForm.telephone, { label: 'Téléphone (facultatif)', attr: { autocomplete: 'tel', placeholder: '06 00 00 00 00' } }) }}</div>
                    <div class="col-12">{{ form_row(registrationForm.email, { label: 'Adresse email', attr: { autocomplete: 'email', placeholder: 'vous@exemple.fr' } }) }}</div>
                    <div class="col-12">
                        {{ form_row(registrationForm.plainPassword, { label: 'Mot de passe', attr: { autocomplete: 'new-password', placeholder: '6 caractères minimum' } }) }}
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            {{ form_widget(registrationForm.agreeTerms) }}
                            <label class="form-check-label" for="{{ registrationForm.agreeTerms.vars.id }}">
                                J'accepte les <a href="{{ path('app_politique') }}" target="_blank" rel="noopener">conditions d'utilisation</a>
                            </label>
                            {{ form_errors(registrationForm.agreeTerms) }}
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg btn-block mt-4" data-submit-lock-target="button"><i class="bi bi-person-check" aria-hidden="true"></i> Créer mon compte</button>
            {{ form_end(registrationForm) }}

            <p class="auth__alt">Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a></p>
        </div>
    </section>
</div>
{% endblock %}
