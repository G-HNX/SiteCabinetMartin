{% extends 'base.html.twig' %}

{% block title %}Confirmer votre rendez-vous — Cabinet Martin{% endblock %}

{% block main %}
{% include 'components/_page_head.html.twig' with {
    eyebrow: 'Dernière étape',
    title: 'Confirmer votre rendez-vous',
    crumbs: [['Rendez-vous', path('app_rendez_vous')], ['Confirmation', null]]
} only %}

<section class="section" style="padding-top: 2.5rem;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <div class="card-c card-c--pad">
                    <div class="recap">
                        <div class="recap__doctor">
                            <img src="{{ asset(doctor.photo ?: 'img/doctors/doctors-1.jpg') }}" alt="" width="72" height="72">
                            <div>
                                <h2>{{ doctor.nomComplet }}</h2>
                                <p>{{ doctor.specMedecin }}</p>
                            </div>
                        </div>
                        <div class="recap__when">
                            <div><i class="bi bi-calendar3" aria-hidden="true"></i> {{ date|format_datetime(pattern: "EEEE d MMMM y")|capitalize }}</div>
                            <div><i class="bi bi-clock" aria-hidden="true"></i> {{ date|date('H:i') }} <span class="text-muted-c fw-normal">(30 minutes)</span></div>
                            <div><i class="bi bi-geo-alt" aria-hidden="true"></i> Cabinet Martin, 7 rue des Archives, Laval</div>
                        </div>
                    </div>

                    <form method="post" action="{{ path('reservation_add', {doctor: doctor.id, slot: slot}) }}" data-controller="submit-lock" data-action="submit->submit-lock#lock" data-submit-lock-label-value="Réservation…">
                        <input type="hidden" name="_token" value="{{ csrf_token('rdv') }}">

                        <label for="motif" class="form-label">Motif de consultation <span class="text-muted-c fw-normal">(facultatif)</span></label>
                        <textarea id="motif" name="motif" class="form-control" rows="4" maxlength="255" placeholder="Ex. : renouvellement d'ordonnance, douleur persistante, bilan annuel…" aria-describedby="motif-aide"></textarea>
                        <p id="motif-aide" class="field-hint">255 caractères maximum. Ne communiquez pas d'informations médicales sensibles ici.</p>

                        <div class="d-flex flex-wrap gap-3 mt-4">
                            <button type="submit" class="btn btn-accent btn-lg" data-submit-lock-target="button"><i class="bi bi-calendar2-check" aria-hidden="true"></i> Confirmer le rendez-vous</button>
                            <a href="{{ path('app_rendez_vous') }}" class="btn btn-ghost btn-lg">Choisir un autre créneau</a>
                        </div>
                    </form>
                </div>
                <p class="field-hint text-center mt-3"><i class="bi bi-envelope-check" aria-hidden="true"></i> Un email de confirmation vous sera envoyé (consultable dans Mailpit en démonstration).</p>
            </div>
        </div>
    </div>
</section>
{% endblock %}
