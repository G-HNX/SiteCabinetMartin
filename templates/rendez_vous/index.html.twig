{% extends 'base.html.twig' %}

{% block title %}Prendre rendez-vous — Cabinet Martin{% endblock %}

{% block main %}
{% include 'components/_page_head.html.twig' with {
    eyebrow: 'Réservation en ligne',
    title: 'Prendre rendez-vous',
    lead: 'Choisissez votre médecin, puis le créneau qui vous convient. Votre réservation est confirmée par email.',
    crumbs: [['Rendez-vous', null]]
} only %}


{% set firstDay = calendar|first %}
{% set lastDay = calendar|last %}

<section class="section" style="padding-top: 2.5rem;">
    <div class="container">

        {% if medecins|length == 0 %}
            <div class="empty-state">
                <div class="empty-state__icon"><i class="bi bi-calendar2-x" aria-hidden="true"></i></div>
                <h2>Aucun médecin disponible</h2>
                <p>La prise de rendez-vous en ligne n'est pas disponible pour le moment. Contactez-nous par téléphone.</p>
                <a href="{{ path('app_contact') }}" class="btn btn-primary">Nous contacter</a>
            </div>
        {% else %}
            <div data-controller="tabs">
                {# ----- Étape 1 : médecin ----- #}
                <h2 class="visually-hidden-c" id="choix-medecin">Choisir un médecin</h2>
                <div class="doctor-tabs" role="tablist" aria-labelledby="choix-medecin">
                    {% for m in medecins %}
                        {% set free = 0 %}
                        {% for day in calendar %}
                            {% for s in day.slots[m.id]|default([]) %}{% if s.available %}{% set free = free + 1 %}{% endif %}{% endfor %}
                        {% endfor %}
                        <button type="button" role="tab" id="tab-{{ m.id }}" class="doctor-tab" data-key="{{ m.id }}"
                                aria-controls="panel-{{ m.id }}" aria-selected="{{ loop.first ? 'true' : 'false' }}"
                                data-tabs-target="tab" data-action="tabs#select keydown->tabs#keydown">
                            <img src="{{ asset(m.photo ?: 'img/doctors/doctors-1.jpg') }}" alt="" width="56" height="56">
                            <span>
                                <strong>{{ m.nomComplet }}</strong>
                                <span>{{ m.specMedecin }}</span>
                            </span>
                            <em class="{{ free == 0 ? 'is-none' }}">{{ free }} créneau{{ free > 1 ? 'x' }}</em>
                        </button>
                    {% endfor %}
                </div>

                {# ----- Étape 2 : semaine et créneaux ----- #}
                <div class="week-nav">
                    <h2>
                        {% if firstDay and lastDay %}
                            Du {{ firstDay.date|format_date(pattern: 'd MMMM') }} au {{ lastDay.date|format_date(pattern: 'd MMMM y') }}
                        {% else %}
                            Créneaux disponibles
                        {% endif %}
                    </h2>
                    <div class="week-nav__btns">
                        <a href="{{ path('app_rendez_vous', {mode: 'move', day: -7}) }}" data-keep-doctor class="btn btn-ghost btn-sm{{ offset == 0 ? ' disabled' }}"{% if offset == 0 %} aria-disabled="true" tabindex="-1"{% endif %}><i class="bi bi-chevron-left" aria-hidden="true"></i> Semaine précédente</a>
                        <a href="{{ path('app_rendez_vous', {mode: 'reset', day: 0}) }}" data-keep-doctor class="btn btn-ghost btn-sm{{ offset == 0 ? ' disabled' }}"{% if offset == 0 %} aria-disabled="true" tabindex="-1"{% endif %}>Aujourd'hui</a>
                        <a href="{{ path('app_rendez_vous', {mode: 'move', day: 7}) }}" data-keep-doctor class="btn btn-ghost btn-sm">Semaine suivante <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    </div>
                </div>

                {% for m in medecins %}
                    <div class="tabs-panel" role="tabpanel" id="panel-{{ m.id }}" aria-labelledby="tab-{{ m.id }}" data-tabs-target="panel" tabindex="0">
                        <div class="week">
                            {% for day in calendar %}
                                {% set slots = day.slots[m.id]|default([]) %}
                                {% set freeDay = slots|filter(s => s.available)|length %}
                                <section class="day" aria-label="{{ day.date|format_date(pattern: 'EEEE d MMMM') }}">
                                    <header class="day__head">
                                        <strong>{{ day.date|format_date(pattern: 'EEEE') }}</strong>
                                        <span>{{ day.date|format_date(pattern: 'd MMM') }}</span>
                                    </header>
                                    <div class="day__slots">
                                        {% for s in slots %}
                                            {% if s.available %}
                                                <a class="slot" href="{{ path('reservation_new', {doctor: m.id, slot: s.iso}) }}" aria-label="Réserver le {{ day.date|format_date(pattern: 'EEEE d MMMM') }} à {{ s.time }} avec {{ m.nomComplet }}">{{ s.time }}</a>
                                            {% else %}
                                                <span class="slot" aria-disabled="true" title="Créneau indisponible"><span class="visually-hidden-c">Indisponible </span>{{ s.time }}</span>
                                            {% endif %}
                                        {% else %}
                                            <p class="day__empty">Aucun créneau</p>
                                        {% endfor %}
                                    </div>
                                </section>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}

                <div class="legend" aria-hidden="true">
                    <span><i></i> Créneau disponible</span>
                    <span><i class="off"></i> Indisponible ou passé</span>
                </div>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
