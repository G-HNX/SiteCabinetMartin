<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Facture n° {{ commande.id }}</title>
    <style>
        @page { margin: 36px 40px; }
        body { font-family: DejaVu Sans, sans-serif; font-size: 11px; color: #12303a; line-height: 1.5; }
        table { border-collapse: collapse; }
        .w100 { width: 100%; }
        .brand { font-size: 22px; font-weight: bold; color: #0e4f5c; }
        .brand span { color: #c2543a; font-style: italic; }
        .muted { color: #5d7279; }
        .title { font-size: 26px; font-weight: bold; color: #0e4f5c; letter-spacing: 1px; }
        .rule { border: 0; border-top: 3px solid #0e4f5c; margin: 18px 0 22px; }
        .label { font-size: 9px; text-transform: uppercase; letter-spacing: 1px; color: #c2543a; font-weight: bold; margin-bottom: 4px; }
        .box { background-color: #f0f7f6; border: 1px solid #d5e6e6; padding: 10px 14px; }
        .lines th { background-color: #0e4f5c; color: #ffffff; font-size: 9px; text-transform: uppercase; letter-spacing: .5px; padding: 8px 10px; text-align: left; }
        .lines td { padding: 8px 10px; border-bottom: 1px solid #e3ece9; }
        .right { text-align: right; }
        .center { text-align: center; }
        .zebra { background-color: #f8fbfa; }
        .total td { padding: 10px; }
        .total .lbl { background-color: #f0f7f6; font-weight: bold; text-transform: uppercase; font-size: 9px; letter-spacing: 1px; text-align: right; }
        .total .amt { background-color: #0e4f5c; color: #ffffff; font-size: 16px; font-weight: bold; text-align: right; }
        .paid { border: 2px solid #1f7a4f; color: #1f7a4f; font-weight: bold; letter-spacing: 2px; padding: 3px 12px; font-size: 12px; }
        .demo { margin-top: 28px; border: 1px dashed #c2543a; background-color: #fbe9e2; color: #7a2f1d; padding: 8px 12px; font-size: 10px; text-align: center; }
        .foot { margin-top: 18px; padding-top: 10px; border-top: 1px solid #d9dfdc; text-align: center; font-size: 9px; color: #7a8c91; }
    </style>
</head>
<body>

<table class="w100">
    <tr>
        <td style="vertical-align: top; width: 55%;">
            <div class="brand">Cabinet <span>Martin</span></div>
            <div class="muted" style="margin-top: 6px;">
                7, rue des Archives — 53 000 Laval<br>
                02 99 99 99 99 — contact@cabinet-martin.fr<br>
                Lun–Ven 8h–18h · Sam 8h–12h
            </div>
        </td>
        <td style="vertical-align: top;" class="right">
            <div class="title">FACTURE</div>
            <div class="muted" style="margin-top: 6px;">
                N° <strong style="color: #12303a;">{{ commande.id }}</strong><br>
                Date : <strong style="color: #12303a;">{{ commande.dateCommande|format_date('short') }}</strong><br>
                Heure : {{ commande.dateCommande|date('H:i') }}
            </div>
        </td>
    </tr>
</table>

<hr class="rule">

<table class="w100">
    <tr>
        <td style="vertical-align: top; width: 55%;">
            <div class="label">Facture établie pour</div>
            <div class="box">
                {% set personne = commande.personne %}
                <strong>{{ personne.prenom }} {{ personne.nom }}</strong>
                {% if personne.telephone %}<br>Tél. : {{ personne.telephone }}{% endif %}
            </div>
        </td>
        <td style="vertical-align: bottom;" class="right">
            <span class="paid">PAYÉE</span>
        </td>
    </tr>
</table>

<div class="label" style="margin-top: 24px;">Détail de la commande</div>
<table class="w100 lines">
    <thead>
        <tr>
            <th style="width: 48%;">Désignation</th>
            <th class="right" style="width: 18%;">Prix unitaire</th>
            <th class="center" style="width: 10%;">Qté</th>
            <th class="right" style="width: 24%;">Sous-total</th>
        </tr>
    </thead>
    <tbody>
        {% for ligne in commande.lignesCommande %}
            <tr{% if loop.index is even %} class="zebra"{% endif %}>
                <td>{{ ligne.medicamentLigneCommande ? ligne.medicamentLigneCommande.nom : 'Article supprimé' }}</td>
                <td class="right">{{ ligne.prix|format_currency('EUR') }}</td>
                <td class="center">{{ ligne.quantite }}</td>
                <td class="right"><strong>{{ ligne.sousTotal|format_currency('EUR') }}</strong></td>
            </tr>
        {% endfor %}
    </tbody>
</table>

<table class="w100 total" style="margin-top: 14px;">
    <tr>
        <td style="width: 50%;"></td>
        <td class="lbl" style="width: 25%;">Total TTC</td>
        <td class="amt" style="width: 25%;">{{ commande.total|format_currency('EUR') }}</td>
    </tr>
</table>

<div class="demo">
    Document de démonstration — projet de portfolio. Commande et paiement fictifs, sans valeur comptable.
</div>

<div class="foot">
    Cabinet Martin — 7, rue des Archives, 53 000 Laval — contact@cabinet-martin.fr<br>
    Document généré le {{ 'now'|format_datetime('short', 'short') }}
</div>

</body>
</html>
