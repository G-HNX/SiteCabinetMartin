{% extends 'base.html.twig' %}

{% block title %}Mes factures — Cabinet Martin{% endblock %}

{% block main %}
{% include 'components/_page_head.html.twig' with {
    eyebrow: 'Espace patient',
    title: 'Mes factures',
    lead: 'Retrouvez et téléchargez les factures de vos commandes de pharmacie.',
    crumbs: [['Mon espace', path('app_profil')], ['Factures', null]]
} only %}

<section class="section">
    <div class="container">
        {% if commandes|length %}
            <div class="invoice-list">
                {% for c in commandes %}
                    <article class="invoice" data-controller="reveal">
                        <span class="invoice__icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></span>
                        <div>
                            <h2>Facture n° {{ c.id }}</h2>
                            <p>{{ c.dateCommande|format_datetime('long', 'short') }} · {{ c.lignesCommande|length }} article{{ c.lignesCommande|length > 1 ? 's' }} <span class="paid ms-2"><i class="bi bi-check2" aria-hidden="true"></i> Payée</span></p>
                        </div>
                        <span class="invoice__amount">{{ c.total|format_currency('EUR') }}</span>
                        <a href="{{ path('app_facture_pdf', {id: c.id}) }}" class="btn btn-primary btn-sm" data-turbo="false"><i class="bi bi-download" aria-hidden="true"></i> Télécharger le PDF</a>
                    </article>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state">
                <div class="empty-state__icon"><i class="bi bi-receipt" aria-hidden="true"></i></div>
                <h2>Aucune facture pour le moment</h2>
                <p>Vos factures apparaîtront ici dès votre première commande en pharmacie.</p>
                <a href="{{ path('app_pharmacie') }}" class="btn btn-primary btn-lg">Visiter la pharmacie</a>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
