{% extends 'base.html.twig' %}

{% block title %}Téléconsultation — Cabinet Martin{% endblock %}

{% block main %}
<section class="section" style="padding-top: clamp(2.5rem, 6vw, 4.5rem);">
    <div class="container">
        <div class="split">
            <div data-controller="reveal">
                <span class="soon-badge">Bientôt disponible</span>
                <h1 style="font-size: clamp(2.2rem, 5vw, 3.5rem);">Consulter un médecin, <em style="color: var(--clay);">depuis chez vous.</em></h1>
                <p class="hero__lead mt-3">
                    La téléconsultation vidéo avec nos médecins ouvrira prochainement.
                    En attendant, réservez un rendez-vous en cabinet, ou écrivez-nous pour toute question.
                </p>
                <div class="hero__cta mb-0">
                    <a href="{{ path('app_rendez_vous') }}" class="btn btn-accent btn-lg"><i class="bi bi-calendar2-plus" aria-hidden="true"></i> Rendez-vous en cabinet</a>
                    <a href="{{ path('app_contact') }}" class="btn btn-ghost btn-lg"><i class="bi bi-envelope" aria-hidden="true"></i> Nous contacter</a>
                </div>
            </div>
            <div class="split__img" data-controller="reveal">
                <img src="{{ asset('img/departments-1.jpg') }}" alt="Stéthoscope posé sur un électrocardiogramme" loading="lazy" width="600" height="525">
            </div>
        </div>
    </div>
</section>

<section class="section section--tint">
    <div class="container">
        <div class="section-head section-head--center" data-controller="reveal">
            <p class="eyebrow">Ce que ça changera</p>
            <h2>Les avantages de la consultation à distance</h2>
        </div>
        <div class="values">
            <article class="value-card" data-controller="reveal">
                <i class="bi bi-house-heart" aria-hidden="true"></i>
                <h3>Depuis chez vous</h3>
                <p>Consultez sans vous déplacer, depuis votre ordinateur ou votre smartphone.</p>
            </article>
            <article class="value-card" data-controller="reveal">
                <i class="bi bi-clock-history" aria-hidden="true"></i>
                <h3>Plages étendues</h3>
                <p>Des horaires élargis pour s'adapter à votre emploi du temps.</p>
            </article>
            <article class="value-card" data-controller="reveal">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                <h3>Sécurisé</h3>
                <p>Connexion chiffrée et confidentialité médicale garanties.</p>
            </article>
        </div>
    </div>
</section>
{% endblock %}
