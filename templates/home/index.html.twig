{% extends 'base.html.twig' %}

{% block title %}Cabinet Martin — Médecins et pharmacie en ligne à Laval{% endblock %}

{% block main %}
{# ===== Hero ===== #}
<section class="hero">
    <div class="container">
        <div class="hero__grid">
            <div>
                <p class="eyebrow">Cabinet médical · Laval</p>
                <h1>Prenez soin de vous, <em>sans attendre.</em></h1>
                <p class="hero__lead">
                    Quatre praticiens à votre écoute, un rendez-vous en quelques clics et une pharmacie en ligne :
                    tout votre parcours de soins réuni dans un seul espace, simple et sécurisé.
                </p>
                <div class="hero__cta">
                    <a href="{{ path('app_rendez_vous') }}" class="btn btn-accent btn-lg"><i class="bi bi-calendar2-check" aria-hidden="true"></i> Prendre rendez-vous</a>
                    <a href="{{ path('app_medecin') }}" class="btn btn-ghost btn-lg">Découvrir nos médecins</a>
                </div>
                <div class="hero__proof">
                    <div><i class="bi bi-clock-history" aria-hidden="true"></i> Créneaux sous quelques jours</div>
                    <div><i class="bi bi-shield-check" aria-hidden="true"></i> Données de santé protégées</div>
                    <div><i class="bi bi-capsule" aria-hidden="true"></i> Pharmacie intégrée</div>
                </div>
            </div>

            <div class="hero__visual">
                <div class="hero__ring" aria-hidden="true"></div>
                <div class="hero__arch">
                    <img src="{{ asset('img/about.jpg') }}" alt="L'équipe médicale du Cabinet Martin" width="1024" height="692" fetchpriority="high">
                </div>
                <div class="float-card float-card--a">
                    <i class="bi bi-calendar2-heart" aria-hidden="true"></i>
                    <div><strong>Rendez-vous en ligne</strong><span>Réservez 24 h/24, 7 j/7</span></div>
                </div>
                <div class="float-card float-card--b">
                    <i class="bi bi-heart-pulse" aria-hidden="true"></i>
                    <div><strong>Suivi personnalisé</strong><span>Un dossier, un interlocuteur</span></div>
                </div>
            </div>
        </div>
    </div>
</section>

{# ===== Accès rapides ===== #}
<section class="quick" aria-label="Accès rapides">
    <div class="container">
        <div class="quick__grid">
            <a href="{{ path('app_rendez_vous') }}" class="quick-card">
                <span class="quick-card__icon"><i class="bi bi-calendar2-week" aria-hidden="true"></i></span>
                <div><h3>Prendre rendez-vous</h3><p>Choisissez votre médecin et un créneau</p></div>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
            <a href="{{ path('app_pharmacie') }}" class="quick-card">
                <span class="quick-card__icon"><i class="bi bi-capsule-pill" aria-hidden="true"></i></span>
                <div><h3>Pharmacie en ligne</h3><p>Vos produits de santé au quotidien</p></div>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
            <a href="{{ path('app_teleconsultation') }}" class="quick-card">
                <span class="quick-card__icon"><i class="bi bi-camera-video" aria-hidden="true"></i></span>
                <div><h3>Téléconsultation</h3><p>Consulter depuis chez vous, bientôt</p></div>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </div>
    </div>
</section>

{# ===== Services ===== #}
<section class="section">
    <div class="container">
        <div class="section-head" data-controller="reveal">
            <p class="eyebrow">Nos services</p>
            <h2>Un accompagnement complet, de la prévention au suivi</h2>
            <p>Prévention, diagnostic, traitement et suivi : nous restons votre point de contact à chaque étape.</p>
        </div>
        <div class="services">
            <article class="service" data-controller="reveal">
                <span class="service__num">01</span>
                <h3>Médecine générale</h3>
                <p>Suivi adulte et enfant, certificats, renouvellements d'ordonnances et conseils de prévention.</p>
            </article>
            <article class="service" data-controller="reveal">
                <span class="service__num">02</span>
                <h3>Spécialistes</h3>
                <p>Pédiatrie, cardiologie et dermatologie sur place, en lien direct avec votre médecin traitant.</p>
            </article>
            <article class="service" data-controller="reveal">
                <span class="service__num">03</span>
                <h3>Vaccins et dépistages</h3>
                <p>Mise à jour vaccinale et dépistages ciblés, adaptés à votre âge et à vos facteurs de risque.</p>
            </article>
            <article class="service" data-controller="reveal">
                <span class="service__num">04</span>
                <h3>Pharmacie en ligne</h3>
                <p>Commandez vos médicaments et produits de santé, retrouvez vos factures dans votre espace.</p>
            </article>
        </div>
    </div>
</section>

{# ===== Médecins ===== #}
<section class="section section--tint">
    <div class="container">
        <div class="section-head section-head--split" data-controller="reveal">
            <div>
                <p class="eyebrow">Votre équipe</p>
                <h2>Des médecins à l'écoute</h2>
                <p>Un suivi global, une communication claire et des délais courts.</p>
            </div>
            <a href="{{ path('app_medecin') }}" class="link-arrow">Voir toute l'équipe <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        </div>
        <div class="doctors">
            {% for m in medecins %}
                {% include 'components/_doctor_card.html.twig' with {m: m} only %}
            {% else %}
                <p>Nos médecins arrivent bientôt.</p>
            {% endfor %}
        </div>
    </div>
</section>

{# ===== Pharmacie ===== #}
{% if produits is not empty %}
<section class="section">
    <div class="container">
        <div class="section-head section-head--split" data-controller="reveal">
            <div>
                <p class="eyebrow">Pharmacie en ligne</p>
                <h2>Sélection du moment</h2>
                <p>Commandez en quelques clics, retrouvez votre facture dans votre espace patient.</p>
            </div>
            <a href="{{ path('app_pharmacie') }}" class="link-arrow">Toute la pharmacie <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        </div>
        <div class="products">
            {% for p in produits %}
                {% include 'components/_product_card.html.twig' with {p: p, cat: p.categorie.id} only %}
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ===== FAQ ===== #}
<section class="section section--sand">
    <div class="container">
        <div class="section-head" data-controller="reveal">
            <p class="eyebrow">Questions fréquentes</p>
            <h2>Préparer votre venue</h2>
            <p>Les réponses aux questions que l'on nous pose le plus souvent.</p>
        </div>
        <div class="faq" data-controller="reveal">
            <details>
                <summary>Quels documents apporter ? <i class="bi bi-plus-lg" aria-hidden="true"></i></summary>
                <p>Votre carte Vitale, une pièce d'identité, la liste de vos médicaments en cours et vos comptes rendus récents.</p>
            </details>
            <details>
                <summary>Proposez-vous la téléconsultation ? <i class="bi bi-plus-lg" aria-hidden="true"></i></summary>
                <p>La téléconsultation vidéo arrive bientôt. En attendant, vous pouvez réserver un rendez-vous en cabinet en ligne ou contacter le secrétariat.</p>
            </details>
            <details>
                <summary>Quels sont les délais pour un rendez-vous ? <i class="bi bi-plus-lg" aria-hidden="true"></i></summary>
                <p>La plupart des motifs obtiennent un créneau sous quelques jours. En cas d'urgence, appelez-nous ; en cas d'urgence vitale, composez le 15.</p>
            </details>
            <details>
                <summary>Comment retrouver ma facture de pharmacie ? <i class="bi bi-plus-lg" aria-hidden="true"></i></summary>
                <p>Toutes vos factures sont disponibles en PDF dans votre espace patient, rubrique « Mes factures ».</p>
            </details>
        </div>
    </div>
</section>

{# ===== Accès ===== #}
<section class="section">
    <div class="container">
        <div class="section-head" data-controller="reveal">
            <p class="eyebrow">Nous trouver</p>
            <h2>L'accès au cabinet</h2>
        </div>
        <div class="contact-grid">
            <div class="contact-info" data-controller="reveal">
                <ul>
                    <li><i class="bi bi-geo-alt" aria-hidden="true"></i><div><strong>Adresse</strong><p>7, rue des Archives<br>53 000 Laval</p></div></li>
                    <li><i class="bi bi-telephone" aria-hidden="true"></i><div><strong>Téléphone</strong><p><a href="tel:+33299999999">02 99 99 99 99</a></p></div></li>
                    <li><i class="bi bi-envelope" aria-hidden="true"></i><div><strong>Email</strong><p><a href="mailto:contact@cabinet-martin.fr">contact@cabinet-martin.fr</a></p></div></li>
                    <li><i class="bi bi-clock" aria-hidden="true"></i><div><strong>Horaires</strong><p>Lun–Ven 8h–18h<br>Sam 8h–12h</p></div></li>
                </ul>
            </div>
            <div class="map-frame" data-controller="reveal">
                <iframe title="Plan d'accès au Cabinet Martin, 7 rue des Archives à Laval"
                    src="https://www.openstreetmap.org/export/embed.html?bbox=-0.7760%2C48.0660%2C-0.7500%2C48.0780&amp;layer=mapnik&amp;marker=48.0719%2C-0.7634"
                    loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>
    </div>
</section>
{% endblock %}
