{% extends 'base.html.twig' %}

{% block title %}À propos — Cabinet Martin{% endblock %}

{% block main %}
{% include 'components/_page_head.html.twig' with {
    eyebrow: 'Le cabinet',
    title: 'Une médecine claire, efficace et humaine',
    lead: 'Le Cabinet Martin propose un parcours de soins lisible, de la prévention au suivi des pathologies chroniques.',
    crumbs: [['À propos', null]]
} only %}

<section class="section">
    <div class="container">
        <div class="split">
            <div class="split__img" data-controller="reveal">
                <img src="{{ asset('img/about.jpg') }}" alt="L'équipe du Cabinet Martin" loading="lazy" width="1024" height="692">
            </div>
            <div data-controller="reveal">
                <p class="eyebrow">Notre approche</p>
                <h2 class="h1" style="font-size: clamp(1.9rem, 3.6vw, 2.7rem);">À propos du cabinet</h2>
                <div class="divider-dots"></div>
                <p>
                    Fondé par le <strong>Dr Philippe Martin</strong>, médecin généraliste, le cabinet réunit aujourd'hui quatre praticiens :
                    médecine générale, pédiatrie, cardiologie et dermatologie.
                    Notre objectif : un parcours de soins clair, efficace et humain, où vous gardez toujours le même point de contact.
                </p>
                <ul class="check-list">
                    <li>
                        <i class="bi bi-clipboard2-pulse" aria-hidden="true"></i>
                        <div><h3>Prise en charge globale</h3><p>De la première consultation au suivi spécialisé, nous restons votre point de contact.</p></div>
                    </li>
                    <li>
                        <i class="bi bi-bandaid" aria-hidden="true"></i>
                        <div><h3>Soins du quotidien</h3><p>Consultations, renouvellements d'ordonnances, certificats, petites urgences non vitales.</p></div>
                    </li>
                    <li>
                        <i class="bi bi-shield-plus" aria-hidden="true"></i>
                        <div><h3>Prévention et dépistage</h3><p>Bilans, vaccinations et dépistages adaptés à votre âge et à vos facteurs de risque.</p></div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="section section--dark" aria-label="Le cabinet en chiffres">
    <div class="container">
        <div class="stats">
            <div class="stat">
                <span class="stat__value"><span data-controller="counter" data-counter-end-value="2">2</span></span>
                <p>Médecins</p>
            </div>
            <div class="stat">
                <span class="stat__value"><span data-controller="counter" data-counter-end-value="2">2</span></span>
                <p>Spécialités</p>
            </div>
            <div class="stat">
                <span class="stat__value"><span data-controller="counter" data-counter-end-value="24">24</span></span>
                <p>Créneaux par jour</p>
            </div>
            <div class="stat">
                <span class="stat__value"><span data-controller="counter" data-counter-end-value="97">97</span><small>%</small></span>
                <p>Patients satisfaits</p>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head section-head--center" data-controller="reveal">
            <p class="eyebrow">Nos engagements</p>
            <h2>Ce qui guide notre pratique</h2>
        </div>
        <div class="values">
            <article class="value-card" data-controller="reveal">
                <i class="bi bi-chat-heart" aria-hidden="true"></i>
                <h3>Écoute</h3>
                <p>Le temps nécessaire pour comprendre, expliquer et décider ensemble de la meilleure prise en charge.</p>
            </article>
            <article class="value-card" data-controller="reveal">
                <i class="bi bi-lightning-charge" aria-hidden="true"></i>
                <h3>Disponibilité</h3>
                <p>Des créneaux réservables en ligne à toute heure et des délais courts pour la plupart des motifs.</p>
            </article>
            <article class="value-card" data-controller="reveal">
                <i class="bi bi-lock" aria-hidden="true"></i>
                <h3>Confidentialité</h3>
                <p>Vos données de santé sont protégées et ne sont partagées qu'avec les professionnels qui vous suivent.</p>
            </article>
        </div>
    </div>
</section>

<section class="section section--sand">
    <div class="container">
        <div class="cta-band" data-controller="reveal">
            <div>
                <h2>Envie de nous rencontrer ?</h2>
                <p>Réservez un créneau en ligne en moins d'une minute, ou écrivez-nous pour toute question.</p>
            </div>
            <div class="cta-band__btns">
                <a href="{{ path('app_rendez_vous') }}" class="btn btn-accent btn-lg">Prendre rendez-vous</a>
                <a href="{{ path('app_contact') }}" class="btn btn-outline-light-c btn-lg">Nous contacter</a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
