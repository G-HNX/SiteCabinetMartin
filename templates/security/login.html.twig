{% extends 'base.html.twig' %}

{% block title %}Connexion — Cabinet Martin{% endblock %}

{% block main %}
<div class="auth">
    <aside class="auth__aside">
        <div>
            <p class="eyebrow" style="color: var(--clay-bright);">Espace patient</p>
            <h2>Content de vous <em>revoir.</em></h2>
            <p>Retrouvez en un lieu unique vos rendez-vous, vos commandes de pharmacie et vos factures.</p>
        </div>
        <ul>
            <li><i class="bi bi-calendar2-check" aria-hidden="true"></i><p><strong>Vos rendez-vous</strong>À venir et passés, avec le détail du médecin.</p></li>
            <li><i class="bi bi-receipt" aria-hidden="true"></i><p><strong>Vos factures</strong>Téléchargeables en PDF à tout moment.</p></li>
            <li><i class="bi bi-shield-lock" aria-hidden="true"></i><p><strong>Données protégées</strong>Connexion sécurisée, confidentialité respectée.</p></li>
        </ul>
    </aside>

    <section class="auth__main">
        <div class="auth__box">
            <h1>Connexion</h1>
            <p class="lead-sub">Accédez à votre espace patient.</p>

            {% if error %}
                <div class="form-error-box" role="alert">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    <p>{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                </div>
            {% endif %}

            {% if app.user %}
                <div class="form-error-box" style="background: var(--mist); border-color: var(--mist); color: var(--petrol-900);">
                    <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                    <p>Vous êtes connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>. <a href="{{ path('app_logout') }}">Se déconnecter</a></p>
                </div>
            {% endif %}

            <form method="post" data-controller="submit-lock" data-action="submit->submit-lock#lock" data-submit-lock-label-value="Connexion…">
                <div class="mb-3">
                    <label for="username" class="form-label">Adresse email</label>
                    <div class="input-icon">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        <input type="email" id="username" name="_username" value="{{ last_username }}" class="form-control{{ error ? ' is-invalid' }}" autocomplete="email" autofocus required placeholder="vous@exemple.fr">
                    </div>
                </div>

                <div class="mb-4" data-controller="password">
                    <label for="password" class="form-label">Mot de passe</label>
                    <div class="input-icon input-icon--toggle">
                        <i class="bi bi-lock" aria-hidden="true"></i>
                        <input type="password" id="password" name="_password" class="form-control{{ error ? ' is-invalid' }}" autocomplete="current-password" required placeholder="Votre mot de passe" data-password-target="input">
                        <button type="button" class="input-icon__btn" data-password-target="button" data-action="password#toggle" aria-label="Afficher le mot de passe" aria-pressed="false"><i class="bi bi-eye" data-password-target="icon" aria-hidden="true"></i></button>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <button class="btn btn-primary btn-lg btn-block" type="submit" data-submit-lock-target="button"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Se connecter</button>
            </form>

            <p class="auth__alt">Pas encore de compte ? <a href="{{ path('app_inscription') }}">Créer un compte</a></p>

            <div class="demo-box">
                <strong><i class="bi bi-person-badge" aria-hidden="true"></i> Compte de démonstration</strong>
                <p>Email : <code>demo@cabinet-martin.fr</code><br>Mot de passe : <code>demo1234</code></p>
            </div>
        </div>
    </section>
</div>
{% endblock %}
