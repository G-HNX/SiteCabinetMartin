<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block email_title %}Cabinet Martin{% endblock %}</title>
</head>
<body style="margin:0;padding:0;background-color:#f1ede4;font-family:Helvetica,Arial,sans-serif;color:#12303a;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f1ede4;">
    <tr>
        <td align="center" style="padding:32px 12px;">
            <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background-color:#ffffff;border-radius:16px;overflow:hidden;">
                {# En-tête #}
                <tr>
                    <td align="center" style="background-color:#0a3a45;padding:28px 32px;">
                        <div style="font-family:Georgia,'Times New Roman',serif;font-size:26px;line-height:1.2;color:#ffffff;">
                            Cabinet <span style="color:#e07a5c;font-style:italic;">Martin</span>
                        </div>
                        <div style="font-size:13px;color:#a9c7cb;margin-top:6px;">7, rue des Archives — 53 000 Laval</div>
                    </td>
                </tr>
                {# Bandeau #}
                <tr>
                    <td align="center" style="background-color:#0e4f5c;padding:26px 32px;">
                        <div style="font-size:30px;line-height:1;color:#ffffff;">{% block email_icon %}&#10003;{% endblock %}</div>
                        <div style="font-family:Georgia,'Times New Roman',serif;font-size:22px;color:#ffffff;margin-top:10px;">{% block email_heading %}{% endblock %}</div>
                    </td>
                </tr>
                {# Corps #}
                <tr>
                    <td style="padding:34px 36px 30px 36px;font-size:15px;line-height:1.65;color:#12303a;">
                        {% block email_body %}{% endblock %}
                    </td>
                </tr>
                {# Démo #}
                <tr>
                    <td style="padding:0 36px 28px 36px;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td style="background-color:#fbe9e2;border:1px dashed #e07a5c;border-radius:10px;padding:12px 16px;font-size:12px;line-height:1.5;color:#7a2f1d;">
                                    <strong>Projet de démonstration</strong> — ce message est généré par un site de portfolio ; les données sont fictives.
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                {# Pied #}
                <tr>
                    <td align="center" style="background-color:#f6f3ec;padding:20px 32px;font-size:12px;line-height:1.6;color:#6b7f85;">
                        Cabinet Martin · 02 99 99 99 99 · contact@cabinet-martin.fr<br>
                        Lundi–vendredi 8h–18h · samedi 8h–12h
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
