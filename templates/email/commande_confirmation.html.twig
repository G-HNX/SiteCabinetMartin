{% extends 'email/_layout.html.twig' %}

{% block email_title %}Commande n° {{ commande.id }} confirmée — Cabinet Martin{% endblock %}
{% block email_icon %}&#10003;{% endblock %}
{% block email_heading %}Commande confirmée{% endblock %}

{% block email_body %}
<p style="margin:0 0 14px 0;">Bonjour <strong>{{ commande.personne.prenom }} {{ commande.personne.nom }}</strong>,</p>
<p style="margin:0 0 24px 0;">
    Votre commande <strong>n° {{ commande.id }}</strong> du <strong>{{ commande.dateCommande|format_datetime(pattern: "d MMMM y 'à' HH:mm") }}</strong>
    a bien été enregistrée. Voici le récapitulatif :
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin-bottom:22px;">
    <tr>
        <td style="background-color:#0e4f5c;color:#ffffff;padding:10px 14px;font-size:12px;letter-spacing:1px;text-transform:uppercase;">Produit</td>
        <td align="center" style="background-color:#0e4f5c;color:#ffffff;padding:10px 14px;font-size:12px;letter-spacing:1px;text-transform:uppercase;">Qté</td>
        <td align="right" style="background-color:#0e4f5c;color:#ffffff;padding:10px 14px;font-size:12px;letter-spacing:1px;text-transform:uppercase;">Sous-total</td>
    </tr>
    {% for ligne in commande.lignesCommande %}
        <tr>
            <td style="padding:11px 14px;border-bottom:1px solid #e9e4d6;font-size:14px;">{{ ligne.medicamentLigneCommande ? ligne.medicamentLigneCommande.nom : 'Article supprimé' }}</td>
            <td align="center" style="padding:11px 14px;border-bottom:1px solid #e9e4d6;font-size:14px;color:#4b6168;">{{ ligne.quantite }}</td>
            <td align="right" style="padding:11px 14px;border-bottom:1px solid #e9e4d6;font-size:14px;font-weight:bold;">{{ ligne.sousTotal|format_currency('EUR') }}</td>
        </tr>
    {% endfor %}
    <tr>
        <td colspan="2" align="right" style="padding:14px;background-color:#f0f7f6;font-weight:bold;color:#0a3a45;">Total TTC</td>
        <td align="right" style="padding:14px;background-color:#f0f7f6;font-weight:bold;font-size:18px;color:#c2543a;">{{ commande.total|format_currency('EUR') }}</td>
    </tr>
</table>

<p style="margin:0;font-size:13px;color:#4b6168;">Retrouvez votre facture au format PDF dans votre espace patient, rubrique « Mes factures ».</p>
{% endblock %}
