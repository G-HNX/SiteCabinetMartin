{% extends 'email/_layout.html.twig' %}

{% block email_title %}Rendez-vous confirmé — Cabinet Martin{% endblock %}
{% block email_icon %}&#9719;{% endblock %}
{% block email_heading %}Rendez-vous confirmé{% endblock %}

{% block email_body %}
<p style="margin:0 0 14px 0;">Bonjour <strong>{{ rdv.patient.personne.prenom }} {{ rdv.patient.personne.nom }}</strong>,</p>
<p style="margin:0 0 24px 0;">Votre rendez-vous au Cabinet Martin a bien été enregistré. Voici le récapitulatif :</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin-bottom:24px;border:1px solid #e1ece9;">
    <tr>
        <td style="padding:13px 18px;background-color:#f0f7f6;color:#6b7f85;font-size:13px;width:34%;border-bottom:1px solid #e1ece9;">Médecin</td>
        <td style="padding:13px 18px;background-color:#f0f7f6;font-weight:bold;color:#0a3a45;border-bottom:1px solid #e1ece9;">
            {{ rdv.medecin.nomComplet }}{% if rdv.medecin.specMedecin %}<br><span style="font-weight:normal;color:#4b6168;font-size:13px;">{{ rdv.medecin.specMedecin }}</span>{% endif %}
        </td>
    </tr>
    <tr>
        <td style="padding:13px 18px;color:#6b7f85;font-size:13px;border-bottom:1px solid #e1ece9;">Date</td>
        <td style="padding:13px 18px;font-weight:bold;color:#0a3a45;border-bottom:1px solid #e1ece9;">{{ rdv.dateDebutRDV|format_datetime(pattern: "EEEE d MMMM y")|capitalize }}</td>
    </tr>
    <tr>
        <td style="padding:13px 18px;background-color:#f0f7f6;color:#6b7f85;font-size:13px;border-bottom:1px solid #e1ece9;">Heure</td>
        <td style="padding:13px 18px;background-color:#f0f7f6;font-weight:bold;color:#0a3a45;border-bottom:1px solid #e1ece9;">{{ rdv.dateDebutRDV|date('H:i') }} – {{ rdv.dateFinRDV|date('H:i') }}</td>
    </tr>
    {% if rdv.commentaireRDV %}
        <tr>
            <td style="padding:13px 18px;color:#6b7f85;font-size:13px;">Motif</td>
            <td style="padding:13px 18px;color:#12303a;">{{ rdv.commentaireRDV }}</td>
        </tr>
    {% endif %}
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:22px;">
    <tr>
        <td style="background-color:#f6f3ec;border-left:4px solid #e07a5c;padding:14px 18px;font-size:14px;line-height:1.7;color:#0a3a45;">
            <strong>Cabinet Martin</strong><br>
            7, rue des Archives — 53 000 Laval<br>
            02 99 99 99 99
        </td>
    </tr>
</table>

<p style="margin:0;font-size:13px;color:#4b6168;">Pour modifier ou annuler ce rendez-vous, contactez-nous au <strong>02 99 99 99 99</strong> ou par email à contact@cabinet-martin.fr.</p>
{% endblock %}
