{% extends 'base.html.twig' %}

{% block title %}Mon panier — Cabinet Martin{% endblock %}

{% block main %}
{% include 'components/_page_head.html.twig' with {
    eyebrow: 'Pharmacie',
    title: 'Mon panier',
    crumbs: [['Pharmacie', path('app_pharmacie')], ['Panier', null]]
} only %}

<section class="section">
    <div class="container">
        {% if items|length == 0 %}
            <div class="empty-state">
                <div class="empty-state__icon"><i class="bi bi-bag" aria-hidden="true"></i></div>
                <h2>Votre panier est vide</h2>
                <p>Parcourez notre pharmacie en ligne et ajoutez vos produits de santé : ils apparaîtront ici.</p>
                <a href="{{ path('app_pharmacie') }}" class="btn btn-primary btn-lg"><i class="bi bi-capsule" aria-hidden="true"></i> Découvrir la pharmacie</a>
            </div>
        {% else %}
            <div class="cart-layout">
                <div>
                    <ul class="cart-list">
                        {% for item in items %}
                            <li class="cart-item">
                                <div class="cart-item__img"><img src="{{ asset(item.image) }}" alt="" loading="lazy" width="96" height="96"></div>
                                <div>
                                    <h2 class="cart-item__title">{{ item.nom }}</h2>
                                    <span class="cart-item__unit">{{ item.prix|format_currency('EUR') }} l'unité</span>
                                </div>
                                <div class="cart-item__controls">
                                    <div class="qty qty--fixed" role="group" aria-label="Quantité de {{ item.nom }}">
                                        <form method="post" action="{{ path('app_panier_decrease', {id: item.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('panier') }}">
                                            <button type="submit" aria-label="Retirer une unité de {{ item.nom }}"><i class="bi bi-dash-lg" aria-hidden="true"></i></button>
                                        </form>
                                        <span class="qty__value" aria-live="polite">{{ item.quantite }}</span>
                                        <form method="post" action="{{ path('app_panier_add', {id: item.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('panier') }}">
                                            <input type="hidden" name="quantite" value="1">
                                            <button type="submit" aria-label="Ajouter une unité de {{ item.nom }}"{% if item.quantite >= item.stock %} disabled title="Stock maximum atteint"{% endif %}><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
                                        </form>
                                    </div>
                                    <span class="cart-item__total">{{ item.sousTotal|format_currency('EUR') }}</span>
                                    <form method="post" action="{{ path('app_panier_remove', {id: item.id}) }}" class="cart-item__remove">
                                        <input type="hidden" name="_token" value="{{ csrf_token('panier') }}">
                                        <button type="submit" class="btn btn-danger-c btn-sm" aria-label="Supprimer {{ item.nom }} du panier"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                    </form>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4">
                        <a href="{{ path('app_pharmacie') }}" class="link-arrow"><i class="bi bi-arrow-left" aria-hidden="true"></i> Continuer mes achats</a>
                        <form method="post" action="{{ path('app_panier_clear') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('panier') }}">
                            <button type="submit" class="btn btn-danger-c btn-sm"><i class="bi bi-x-circle" aria-hidden="true"></i> Vider le panier</button>
                        </form>
                    </div>
                </div>

                <aside class="card-c summary" aria-label="Récapitulatif">
                    <h2>Récapitulatif</h2>
                    <dl>
                        <div><dt>Articles</dt><dd>{{ items|reduce((carry, i) => carry + i.quantite, 0) }}</dd></div>
                        <div><dt>Livraison</dt><dd>Retrait au cabinet</dd></div>
                    </dl>
                    <div class="summary__total"><span>Total TTC</span><span class="price">{{ total|format_currency('EUR') }}</span></div>

                    {% if app.user %}
                        <a href="{{ path('app_paiement') }}" class="btn btn-accent btn-lg btn-block"><i class="bi bi-lock" aria-hidden="true"></i> Passer au paiement</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn btn-accent btn-lg btn-block"><i class="bi bi-person" aria-hidden="true"></i> Se connecter pour payer</a>
                        <p class="field-hint text-center">Un compte est nécessaire pour finaliser la commande.</p>
                    {% endif %}

                    <ul class="reassure">
                        <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i>Paiement simulé en démonstration</li>
                        <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i>Facture PDF dans votre espace patient</li>
                    </ul>
                </aside>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
