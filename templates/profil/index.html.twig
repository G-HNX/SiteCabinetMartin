{% extends 'base.html.twig' %}

{% block title %}Mon espace patient — Cabinet Martin{% endblock %}

{% block main %}
{% set prenom = personne ? personne.prenom : null %}
<section class="page-head">
    <div class="container">
        <div class="profile-head">
            <div class="profile-head__avatar" aria-hidden="true">{{ (prenom ?: app.user.userIdentifier)|first|upper }}</div>
            <div>
                <p class="eyebrow" style="margin-bottom: .4rem;">Espace patient</p>
                <h1>{{ personne ? (personne.prenom ~ ' ' ~ personne.nom) : app.user.userIdentifier }}</h1>
                <p>Vos rendez-vous, commandes et factures.</p>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="profile-layout">
            {# ----- Colonne latérale ----- #}
            <aside>
                <div class="card-c card-c--pad mb-3" data-controller="reveal">
                    <h2 style="font-size: 1.35rem; margin-bottom: 1.25rem;">Mes informations</h2>
                    <ul class="info-list">
                        {% if personne %}
                            <li><i class="bi bi-person" aria-hidden="true"></i><div><small>Nom</small><span>{{ personne.prenom }} {{ personne.nom }}</span></div></li>
                            <li><i class="bi bi-telephone" aria-hidden="true"></i><div><small>Téléphone</small><span>{{ personne.telephone ?: 'Non renseigné' }}</span></div></li>
                        {% endif %}
                        <li><i class="bi bi-envelope" aria-hidden="true"></i><div><small>Email</small><span>{{ app.user.userIdentifier }}</span></div></li>
                        <li>
                            <i class="bi bi-patch-check" aria-hidden="true"></i>
                            <div><small>Adresse email</small>
                                {% if app.user.verified %}<span class="paid">Vérifiée</span>{% else %}<span class="stock-badge stock-badge--low">À confirmer</span>{% endif %}
                            </div>
                        </li>
                    </ul>
                </div>
                <div class="d-grid gap-2">
                    <a href="{{ path('app_rendez_vous') }}" class="btn btn-accent"><i class="bi bi-calendar2-plus" aria-hidden="true"></i> Nouveau rendez-vous</a>
                    <a href="{{ path('app_pharmacie') }}" class="btn btn-ghost"><i class="bi bi-capsule" aria-hidden="true"></i> Pharmacie</a>
                    <a href="{{ path('app_facture') }}" class="btn btn-ghost"><i class="bi bi-receipt" aria-hidden="true"></i> Mes factures</a>
                </div>
            </aside>

            {# ----- Contenu ----- #}
            <div>
                <section class="profile-block" aria-labelledby="rdv-avenir">
                    <div class="block-title">
                        <h2 id="rdv-avenir">Rendez-vous à venir</h2>
                        <span class="count-pill">{{ rdvsAVenir|length }}</span>
                    </div>
                    {% if rdvsAVenir|length %}
                        <ul class="rdv-list">
                            {% for rdv in rdvsAVenir %}
                                {% include 'profil/_rdv.html.twig' with {rdv: rdv, past: false} only %}
                            {% endfor %}
                        </ul>
                    {% else %}
                        <div class="empty-inline">
                            <i class="bi bi-calendar2-x" aria-hidden="true"></i>
                            <p>Aucun rendez-vous prévu.</p>
                            <a href="{{ path('app_rendez_vous') }}" class="btn btn-primary btn-sm">Prendre rendez-vous</a>
                        </div>
                    {% endif %}
                </section>

                {% if rdvsPasses|length %}
                    <section class="profile-block" aria-labelledby="rdv-passes">
                        <div class="block-title">
                            <h2 id="rdv-passes">Rendez-vous passés</h2>
                            <span class="count-pill">{{ rdvsPasses|length }}</span>
                        </div>
                        <ul class="rdv-list">
                            {% for rdv in rdvsPasses %}
                                {% include 'profil/_rdv.html.twig' with {rdv: rdv, past: true} only %}
                            {% endfor %}
                        </ul>
                    </section>
                {% endif %}

                <section class="profile-block" aria-labelledby="commandes">
                    <div class="block-title">
                        <h2 id="commandes">Mes commandes</h2>
                        <span class="count-pill">{{ commandes|length }}</span>
                    </div>
                    {% if commandes|length %}
                        {% for c in commandes %}
                            <details class="order">
                                <summary>
                                    <span class="order__id">Commande n° {{ c.id }}</span>
                                    <span class="order__date">{{ c.dateCommande|format_datetime('long', 'short') }}</span>
                                    <span class="order__total">{{ c.total|format_currency('EUR') }}</span>
                                    <i class="bi bi-chevron-down order__chev" aria-hidden="true"></i>
                                </summary>
                                <div class="order__body">
                                    <table class="order-table">
                                        <thead><tr><th scope="col">Produit</th><th scope="col" class="num">Prix</th><th scope="col" class="num">Qté</th><th scope="col" class="num">Sous-total</th></tr></thead>
                                        <tbody>
                                            {% for l in c.lignesCommande %}
                                                <tr>
                                                    <td>{{ l.medicamentLigneCommande ? l.medicamentLigneCommande.nom : 'Article supprimé' }}</td>
                                                    <td class="num">{{ l.prix|format_currency('EUR') }}</td>
                                                    <td class="num">{{ l.quantite }}</td>
                                                    <td class="num">{{ l.sousTotal|format_currency('EUR') }}</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                        <tfoot><tr><td colspan="3" class="num">Total</td><td class="num">{{ c.total|format_currency('EUR') }}</td></tr></tfoot>
                                    </table>
                                    <a href="{{ path('app_facture_pdf', {id: c.id}) }}" class="btn btn-ghost btn-sm" data-turbo="false"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Télécharger la facture</a>
                                </div>
                            </details>
                        {% endfor %}
                    {% else %}
                        <div class="empty-inline">
                            <i class="bi bi-bag" aria-hidden="true"></i>
                            <p>Vous n'avez pas encore passé de commande.</p>
                            <a href="{{ path('app_pharmacie') }}" class="btn btn-primary btn-sm">Visiter la pharmacie</a>
                        </div>
                    {% endif %}
                </section>
            </div>
        </div>
    </div>
</section>
{% endblock %}
