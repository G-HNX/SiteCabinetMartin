<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0e4f5c">
    <title>{% block title %}Cabinet Martin{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Cabinet Martin à Laval : prise de rendez-vous en ligne, pharmacie en ligne et espace patient sécurisé.{% endblock %}">

    <link rel="icon" type="image/svg+xml" href="{{ asset('img/favicon.svg') }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet">

    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}
</head>
{# Turbo Drive désactivé : pages classiques, téléchargements PDF et scripts sans surprise #}
<body data-turbo="false" class="{% block body_class %}{% endblock %}">
{% set current = app.request.attributes.get('_route') ?? '' %}
{% set cartCount = cart_count() %}
{% set isMedecin = app.user and is_granted('ROLE_MEDECIN') %}

<a class="skip-link" href="#contenu">Aller au contenu</a>

{# ===== Notifications (flashes) ===== #}
<div class="toasts" aria-live="polite" aria-atomic="false">
    {% for type, messages in app.flashes %}
        {% set kind = type in ['error', 'danger', 'verify_email_error'] ? 'error' : (type == 'success' ? 'success' : 'info') %}
        {% for message in messages %}
            <div class="toast-c toast-c--{{ kind }}" role="{{ kind == 'error' ? 'alert' : 'status' }}" data-controller="flash">
                <i class="bi {{ kind == 'success' ? 'bi-check-circle-fill' : (kind == 'error' ? 'bi-exclamation-triangle-fill' : 'bi-info-circle-fill') }}" aria-hidden="true"></i>
                <p>{{ message }}</p>
                <button type="button" class="toast-c__close" data-action="flash#close" aria-label="Fermer la notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

{# ===== Bandeau de vérification d'email ===== #}
{% if app.user and not app.user.verified %}
    <div class="verify-bar">
        <div class="container verify-bar__inner">
            <p>
                <i class="bi bi-envelope-exclamation" aria-hidden="true"></i>
                <strong>Confirmez votre adresse email.</strong>
                <span>Un lien vous a été envoyé. En démonstration, les emails arrivent dans <a href="http://localhost:8025" target="_blank" rel="noopener">Mailpit</a>.</span>
            </p>
            <form method="post" action="{{ path('app_verify_resend') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('verify_resend') }}">
                <button type="submit" class="verify-bar__btn">Renvoyer l'email</button>
            </form>
        </div>
    </div>
{% endif %}

{# ===== En-tête ===== #}
<header class="site-header" data-controller="nav">
    <div class="topbar">
        <div class="container topbar__inner">
            <p class="topbar__item"><i class="bi bi-clock" aria-hidden="true"></i> Lun–Ven 8h–18h · Sam 8h–12h</p>
            <p class="topbar__item">
                <a href="tel:+33299999999"><i class="bi bi-telephone" aria-hidden="true"></i> 02 99 99 99 99</a>
                <a href="mailto:contact@cabinet-martin.fr" class="d-none d-md-inline"><i class="bi bi-envelope" aria-hidden="true"></i> contact@cabinet-martin.fr</a>
            </p>
        </div>
    </div>

    <div class="container navbar-c">
        <a href="{{ path('app_home') }}" class="brand" aria-label="Cabinet Martin — accueil">
            {% include 'components/_brand_mark.html.twig' %}
            <span class="brand__text">Cabinet <em>Martin</em></span>
        </a>

        <nav class="nav-panel" id="menu-principal" aria-label="Navigation principale" data-nav-target="panel">
            <ul class="nav-links">
                <li><a href="{{ path('app_home') }}" class="{{ current == 'app_home' ? 'is-active' }}" {{ current == 'app_home' ? 'aria-current="page"' }}>Accueil</a></li>
                <li><a href="{{ path('app_about') }}" class="{{ current == 'app_about' ? 'is-active' }}" {{ current == 'app_about' ? 'aria-current="page"' }}>À propos</a></li>
                <li><a href="{{ path('app_medecin') }}" class="{{ current == 'app_medecin' ? 'is-active' }}" {{ current == 'app_medecin' ? 'aria-current="page"' }}>Médecins</a></li>
                <li><a href="{{ path('app_pharmacie') }}" class="{{ current starts with 'app_pharmacie' ? 'is-active' }}">Pharmacie</a></li>
                <li><a href="{{ path('app_teleconsultation') }}" class="{{ current == 'app_teleconsultation' ? 'is-active' }}" {{ current == 'app_teleconsultation' ? 'aria-current="page"' }}>Téléconsultation</a></li>
                <li><a href="{{ path('app_contact') }}" class="{{ current == 'app_contact' ? 'is-active' }}" {{ current == 'app_contact' ? 'aria-current="page"' }}>Contact</a></li>
            </ul>

            <div class="nav-actions">
                <a href="{{ path('app_rendez_vous') }}" class="btn btn-accent btn-sm nav-cta"><i class="bi bi-calendar2-check" aria-hidden="true"></i> Prendre rendez-vous</a>

                {% if app.user %}
                    <div class="account" data-controller="dropdown">
                        <button type="button" class="account__btn" data-dropdown-target="button" data-action="dropdown#toggle" aria-expanded="false" aria-haspopup="true">
                            <span class="account__avatar" aria-hidden="true">{{ (app.user.personne ? app.user.personne.prenom : app.user.email)|first|upper }}</span>
                            <span class="account__name">{{ app.user.personne ? app.user.personne.prenom : 'Mon compte' }}</span>
                            <i class="bi bi-chevron-down account__chevron" aria-hidden="true"></i>
                        </button>
                        <div class="account__menu" data-dropdown-target="menu">
                            <p class="account__mail">{{ app.user.userIdentifier }}</p>
                            {% if not isMedecin %}
                                <a href="{{ path('app_profil') }}"><i class="bi bi-person-circle" aria-hidden="true"></i> Mon espace patient</a>
                                <a href="{{ path('app_facture') }}"><i class="bi bi-receipt" aria-hidden="true"></i> Mes factures</a>
                            {% else %}
                                <p class="account__note"><i class="bi bi-person-badge" aria-hidden="true"></i> Compte médecin</p>
                            {% endif %}
                            <a href="{{ path('app_logout') }}" class="is-danger"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Se déconnecter</a>
                        </div>
                    </div>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-ghost btn-sm"><i class="bi bi-person" aria-hidden="true"></i> Connexion</a>
                {% endif %}
            </div>
        </nav>

        <a href="{{ path('app_panier') }}" class="icon-btn cart-btn" aria-label="Panier{% if cartCount > 0 %}, {{ cartCount }} article{{ cartCount > 1 ? 's' }}{% endif %}">
            <i class="bi bi-bag" aria-hidden="true"></i>
            {% if cartCount > 0 %}<span class="cart-btn__badge">{{ cartCount }}</span>{% endif %}
        </a>

        <button type="button" class="icon-btn nav-toggle" data-nav-target="toggle" data-action="nav#toggle" aria-expanded="false" aria-controls="menu-principal" aria-label="Menu">
            <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
    </div>
    <div class="nav-backdrop" data-action="click->nav#close"></div>
</header>

<main id="contenu">
    {% block main %}{% endblock %}
</main>

{# ===== Pied de page ===== #}
<footer class="site-footer">
    <div class="container">
        <div class="site-footer__grid">
            <div class="site-footer__about">
                <a href="{{ path('app_home') }}" class="brand brand--light">
                    {% include 'components/_brand_mark.html.twig' %}
                    <span class="brand__text">Cabinet <em>Martin</em></span>
                </a>
                <p>Un cabinet médical à taille humaine : rendez-vous en ligne, pharmacie et suivi réunis dans un seul espace.</p>
                <address>
                    7, rue des Archives<br>
                    53 000 Laval<br>
                    <a href="tel:+33299999999">02 99 99 99 99</a>
                </address>
            </div>

            <nav aria-label="Le cabinet">
                <h2 class="site-footer__title">Le cabinet</h2>
                <ul>
                    <li><a href="{{ path('app_about') }}">À propos</a></li>
                    <li><a href="{{ path('app_medecin') }}">Nos médecins</a></li>
                    <li><a href="{{ path('app_teleconsultation') }}">Téléconsultation</a></li>
                    <li><a href="{{ path('app_contact') }}">Contact</a></li>
                </ul>
            </nav>

            <nav aria-label="Services">
                <h2 class="site-footer__title">Services</h2>
                <ul>
                    <li><a href="{{ path('app_rendez_vous') }}">Prendre rendez-vous</a></li>
                    <li><a href="{{ path('app_pharmacie') }}">Pharmacie en ligne</a></li>
                    <li><a href="{{ path('app_panier') }}">Mon panier</a></li>
                    {% if app.user %}
                        <li><a href="{{ path('app_profil') }}">Mon espace patient</a></li>
                    {% else %}
                        <li><a href="{{ path('app_login') }}">Connexion</a></li>
                        <li><a href="{{ path('app_inscription') }}">Créer un compte</a></li>
                    {% endif %}
                </ul>
            </nav>

            <div>
                <h2 class="site-footer__title">Horaires</h2>
                <ul class="site-footer__hours">
                    <li><span>Lundi – Vendredi</span><span>8h – 18h</span></li>
                    <li><span>Samedi</span><span>8h – 12h</span></li>
                    <li><span>Dimanche</span><span>Fermé</span></li>
                </ul>
                <p class="site-footer__urgence"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i> Urgence vitale : appelez le 15</p>
            </div>
        </div>

        <div class="site-footer__demo">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <p><strong>Projet de démonstration</strong> — ce site est une réalisation de portfolio. Les médecins, produits, commandes et paiements sont fictifs ; aucune donnée bancaire n'est collectée.</p>
        </div>

        <div class="site-footer__bottom">
            <p>© {{ 'now'|date('Y') }} Cabinet Martin. Tous droits réservés.</p>
            <a href="{{ path('app_politique') }}">Mentions légales et confidentialité</a>
        </div>
    </div>
</footer>
</body>
</html>
