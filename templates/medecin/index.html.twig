{% extends 'base.html.twig' %}

{% block title %}Nos médecins — Cabinet Martin{% endblock %}

{% block main %}
{% include 'components/_page_head.html.twig' with {
    eyebrow: 'Votre équipe',
    title: 'Nos médecins',
    lead: 'Deux praticiens complémentaires, à votre écoute pour un suivi global et personnalisé.',
    crumbs: [['Médecins', null]]
} only %}

<section class="section">
    <div class="container">
        <div class="doctors">
            {% for m in medecins %}
                {% include 'components/_doctor_card.html.twig' with {m: m} only %}
            {% else %}
                <div class="empty-inline" style="grid-column: 1 / -1;">
                    <i class="bi bi-person-badge" aria-hidden="true"></i>
                    <p>Aucun médecin n'est référencé pour le moment.</p>
                </div>
            {% endfor %}
        </div>

        <div class="cta-band mt-5" data-controller="reveal">
            <div>
                <h2>Un créneau vous attend</h2>
                <p>Choisissez votre médecin et réservez en ligne, sans appel ni file d'attente.</p>
            </div>
            <div class="cta-band__btns">
                <a href="{{ path('app_rendez_vous') }}" class="btn btn-accent btn-lg"><i class="bi bi-calendar2-check" aria-hidden="true"></i> Voir les disponibilités</a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
